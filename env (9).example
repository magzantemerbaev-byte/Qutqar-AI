# ─────────────────────────────────────────────────────────────────────
# QUTQAR AI — переменные окружения ФРОНТЕНДА (скопируйте в .env.local)
# ─────────────────────────────────────────────────────────────────────
# ВНИМАНИЕ: все переменные VITE_* встраиваются в JavaScript-бандл и видны
# любому пользователю. Ключи AI-провайдеров здесь НЕ задаются — только в
# server/.env (AI_API_KEY, AI_API_URL, AI_MODEL). Схема:
#     браузер → backend /api/* → AI-модель
# ─────────────────────────────────────────────────────────────────────

# Адрес backend. Пусто — запросы идут на тот же адрес (/api/...).
# В режиме разработки Vite проксирует /api на http://localhost:8787.
# Пример для раздельного развертывания: https://qutqar-api.example.kz
VITE_API_BASE_URL=

# Необязательно: собственный тайловый сервер карты (например, ведомственная ГИС)
# https://tiles.example.kz/{z}/{x}/{y}.png
VITE_MAP_TILE_URL=
