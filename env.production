# Публичная демонстрационная сборка (Vercel / любой статический хостинг).
# Не секрет: переменные VITE_* видны в бандле. Ключей AI здесь НЕТ и быть не должно.
# true (по умолчанию, даже без этого файла) — сайт всегда в DEMO MODE; переключатель LIVE заблокирован.
# Чтобы собрать версию с backend, задайте VITE_PUBLIC_DEMO=false в настройках хостинга.
VITE_PUBLIC_DEMO=true
