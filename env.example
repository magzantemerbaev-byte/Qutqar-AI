# ═══════════════════════════════════════════════════════════════════
#  QUTQAR AI backend — переменные окружения (скопируйте в server/.env)
#  Эти значения живут ТОЛЬКО на сервере. Фронтенд их никогда не видит.
# ═══════════════════════════════════════════════════════════════════

PORT=8787
# Откуда разрешены запросы браузера (через запятую)
CORS_ORIGIN=http://localhost:5173

# ── AI-модель ───────────────────────────────────────────────────────
# Пустой AI_API_KEY → backend работает в mock-режиме (симулированные ответы,
# помечены meta.mode = "mock").
AI_API_KEY=
# openai — любой OpenAI-совместимый API (OpenAI, Azure OpenAI, vLLM, Ollama, LM Studio…)
# anthropic — Anthropic Messages API
AI_PROVIDER=openai
# Базовый URL API. Примеры:
#   https://api.openai.com/v1
#   https://api.anthropic.com/v1
#   http://localhost:11434/v1          (Ollama, локальная модель в закрытом контуре)
AI_API_URL=https://api.openai.com/v1
AI_MODEL=
# Модель с поддержкой изображений (по умолчанию = AI_MODEL)
AI_VISION_MODEL=
AI_TIMEOUT_MS=45000
# Принудительный mock-режим даже при заданном ключе (true/false)
AI_MOCK=false

# ── Компьютерное зрение ─────────────────────────────────────────────
# llm  — мультимодальная модель AI_VISION_MODEL
# http — собственный сервис детекции (YOLO и т. п.): POST multipart image → JSON
VISION_PROVIDER=llm
VISION_API_URL=

# ── RAG: эмбеддинги и хранилище ─────────────────────────────────────
# Пусто → локальный hashing-эмбеддер (работает офлайн, качество ниже)
EMBEDDING_MODEL=
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
# Минимальная близость фрагмента (0..1). По умолчанию 0.12 для hash, 0.30 для модели.
RAG_MIN_SCORE=
KB_DATA_DIR=./data
# Включать демонстрационные документы в индекс (true/false)
KB_INCLUDE_DEMO=true
# Токен администратора для загрузки/удаления документов (заголовок x-admin-token).
# Задайте обязательно при любом развертывании за пределами локальной машины.
KB_ADMIN_TOKEN=
KB_MAX_UPLOAD_MB=20

# ── Оперативные данные ─────────────────────────────────────────────
# URL API ЦУКС / ГИС, возвращающего OperationalSnapshot (см. shared/contracts.ts).
# Пусто → «Источник оперативных данных не подключен».
OPERATIONAL_DATA_URL=
OPERATIONAL_DATA_TOKEN=

# ── Прочее ─────────────────────────────────────────────────────────
RATE_LIMIT_PER_MIN=60
# Путь к собранному фронтенду (../dist), чтобы отдавать сайт и API с одного адреса
SERVE_STATIC=
