{
  "name": "qutqar-ai",
  "private": true,
  "version": "0.3.1",
  "description": "QUTQAR AI — prototype of an intelligent decision-support system for rescue units (Republic of Kazakhstan)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "server:install": "npm --prefix server install",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:start": "npm --prefix server run start",
    "typecheck:all": "tsc --noEmit && npm --prefix server run typecheck",
    "check": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.0.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "engines": {
    "node": ">=18.18"
  }
}
